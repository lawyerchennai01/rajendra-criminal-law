---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="The page you requested could not be found.">
  <section class="max-w-2xl mx-auto px-6 py-24 text-center">
    <p class="text-gold text-sm uppercase tracking-widest mb-4">404</p>
    <h1 class="font-serif text-4xl md:text-5xl text-navy mb-6">Page Not Found</h1>
    <p class="text-ink/80 mb-10">The page you are looking for does not exist or has been moved.</p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/" class="bg-navy text-cream px-8 py-3 rounded-sm hover:bg-navy/90 transition">Return Home</a>
      <a href="/contact" class="border border-navy text-navy px-8 py-3 rounded-sm hover:bg-navy hover:text-cream transition">Contact Us</a>
    </div>
  </section>
</Layout>
